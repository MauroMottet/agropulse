# Configuración de Redpanda y Supabase para Infraestructura Backend
KAFKA_BROKERS=localhost:9094
TICK_INTERVAL_SEC=5
SIMULATOR_PORT=4000
PAUSED_PLOT_IDS=22222222-2222-2222-2222-222222222223

# Credenciales Supabase (Backend Worker con permisos elevados)
# IMPORTANTE: La clave 'service_role' NUNCA debe incluirse en la app móvil del cliente.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
COMMAND_POLL_INTERVAL_MS=1500
